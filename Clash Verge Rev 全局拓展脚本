
function main(config) {

  // ==============================
  // 1. 排除指定的 Proxy Providers
  // ==============================

  const excludedProviders = [
    "FeiniaoYun"
  ];

  const excludedSet = new Set(excludedProviders);
  const providers = config["proxy-providers"] || {};

  excludedProviders.forEach(name => {
    delete providers[name];
  });

  config["proxy-providers"] = providers;

  // 清理代理组中对已删除 Provider 的引用
  const groups = config["proxy-groups"] || [];

  groups.forEach(group => {
    if (Array.isArray(group.use)) {
      group.use = group.use.filter(
        name => !excludedSet.has(name)
      );

      if (group.use.length === 0) {
        delete group.use;
      }
    }
  });

  // ==============================
  // 2. 进程分流名单
  // ==============================

  // 新加坡：精确进程名称匹配
  const singaporeProcesses = [
    // "Telegram",
  ];

  // 美国：正则进程名称匹配
  const usProcessRegex = [
    // Antigravity 主进程及所有 Helper 子进程
    "(?i).*antigravity.*",
    "(?i).*devin.*",
    // 其他应用可以继续添加正则
    // "^Google Chrome$",
    // "^Code( Helper.*)?$",
  ];

  // ==============================
  // 3. 自动创建地区策略组
  // ==============================

  const regionGroups = [
    {
      name: "新加坡节点",
      filter: "(?i)(新加坡|狮城|Singapore|🇸🇬|\\bSG\\b)"
    },
    {
      name: "美国节点",
      filter: "(?i)(美国|United States|UnitedStates|USA|🇺🇸|\\bUS\\b)"
    }
  ];

  regionGroups.forEach(region => {

    const exists = groups.some(
      group => group.name === region.name
    );

    if (!exists) {
      groups.push({
        name: region.name,
        type: "url-test",
        "include-all": true,
        filter: region.filter,
        url: "https://www.gstatic.com/generate_204",
        interval: 300,
        tolerance: 50
      });
    }
  });

  config["proxy-groups"] = groups;

  // ==============================
  // 4. 生成进程分流规则
  // ==============================

  const processRules = [];

  // 新加坡：PROCESS-NAME
  singaporeProcesses.forEach(process => {
    processRules.push(
      `PROCESS-NAME,${process},新加坡节点`
    );
  });

  // 美国：PROCESS-NAME-REGEX
  usProcessRegex.forEach(regex => {
    processRules.push(
      `PROCESS-NAME-REGEX,${regex},美国节点`
    );
  });

  // ==============================
  // 5. 清理本脚本管理的旧规则
  // ==============================

  const managedRules = new Set([
    ...singaporeProcesses.flatMap(process => [
      `PROCESS-NAME,${process},新加坡节点`,
      `PROCESS-NAME,${process},美国节点`
    ]),

    ...usProcessRegex.map(regex =>
      `PROCESS-NAME-REGEX,${regex},美国节点`
    )
  ]);

  // 兼容清理之前版本生成的 Antigravity 精确匹配规则
  [
    "Antigravity",
    "Antigravity Helper",
    "Antigravity Helper (Renderer)"
  ].forEach(process => {
    managedRules.add(
      `PROCESS-NAME,${process},美国节点`
    );
  });

  config.rules = [
    ...processRules,
    ...(config.rules || []).filter(
      rule => !managedRules.has(rule)
    )
  ];

  return config;
}
